{
  "engine": "1.1.0",
  "owner": "Brander",
  "target": "health",
  "family": "Health",
  "settings": {
    "name": "Health",
    "industry": [
      "health"
    ],
    "dynamic-color": "opt-in",
    "dynamic-color-reason": "Clinical apps benefit from feeling native; users may switch to wallpaper colors in settings, but status colors (vitals, alerts) are never replaced.",
    "radius-component": "lg",
    "radius-container": "xl",
    "fonts": {
      "display": {
        "family": "Atkinson Hyperlegible Next",
        "fallback": "system-ui, sans-serif",
        "license": "OFL"
      },
      "ui": {
        "family": "Atkinson Hyperlegible Next",
        "fallback": "system-ui, sans-serif",
        "license": "OFL"
      },
      "reading": {
        "family": "Atkinson Hyperlegible Next",
        "fallback": "system-ui, sans-serif",
        "license": "OFL"
      },
      "mono": {
        "family": "Atkinson Hyperlegible Mono",
        "fallback": "ui-monospace, monospace",
        "license": "OFL"
      }
    }
  },
  "industries": [
    {
      "id": "health",
      "name": "Health and care",
      "rules": {
        "contrast-text-min": 7,
        "contrast-ui-min": 3,
        "font-size-min": "16px",
        "touch-min": "48px",
        "dynamic-color": [
          "never",
          "opt-in"
        ]
      },
      "guidelines": [
        "Aim for WCAG 2.2 AAA wherever it is achievable, not only for contrast.",
        "Status (normal, attention, critical) is always shown with an icon and words, never color alone, and status colors are never replaced by wallpaper colors.",
        "Clinical values always carry their unit and reference range.",
        "Destructive and irreversible actions (deleting records, sending prescriptions) require explicit confirmation that names what will happen.",
        "Plan for offline and poor connectivity: show sync state and never lose input.",
        "Plain language at about an 8th grade reading level for patient facing text."
      ]
    }
  ],
  "rules": {
    "contrast-text-min": 7,
    "contrast-ui-min": 3,
    "font-size-min": 16,
    "touch-min": 48,
    "dynamic-color": [
      "never",
      "opt-in"
    ]
  },
  "signatures": {
    "focus": {
      "width": "3px",
      "offset": "2px",
      "$description": "Same ring geometry in every Brander family"
    },
    "easing": {
      "name": "settle",
      "value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Every enter and move transition"
    },
    "tick-rule": true,
    "ui-font-default": "Atkinson Hyperlegible Next"
  },
  "color": {
    "light": {
      "background": "#F7FAFB",
      "foreground": "#121A1E",
      "card": "#FFFFFF",
      "card-foreground": "#121A1E",
      "popover": "#FFFFFF",
      "popover-foreground": "#121A1E",
      "primary": "#0C5753",
      "primary-foreground": "#FFFFFF",
      "secondary": "#EEF3F5",
      "secondary-foreground": "#1F2A30",
      "muted": "#EEF3F5",
      "muted-foreground": "#3E4C53",
      "accent": "#D3F0EE",
      "accent-foreground": "#121A1E",
      "destructive": "#A1301E",
      "destructive-foreground": "#FFFFFF",
      "border": "#DDE6EA",
      "input": "#5C6E77",
      "ring": "#0C5753",
      "highlight": "#0C5753"
    },
    "dark": {
      "background": "#0B1114",
      "foreground": "#EEF3F5",
      "card": "#121A1E",
      "card-foreground": "#EEF3F5",
      "popover": "#1F2A30",
      "popover-foreground": "#EEF3F5",
      "primary": "#7FD3CC",
      "primary-foreground": "#0B1114",
      "secondary": "#1F2A30",
      "secondary-foreground": "#EEF3F5",
      "muted": "#121A1E",
      "muted-foreground": "#DDE6EA",
      "accent": "#1F2A30",
      "accent-foreground": "#7FD3CC",
      "destructive": "#F4A394",
      "destructive-foreground": "#0B1114",
      "border": "#1F2A30",
      "input": "#5C6E77",
      "ring": "#7FD3CC",
      "highlight": "#7FD3CC"
    }
  },
  "foundation": {
    "$description": "Health industry rule: no text below 16px.",
    "space": {
      "0": {
        "$value": "0px"
      },
      "1": {
        "$value": "4px"
      },
      "2": {
        "$value": "8px"
      },
      "3": {
        "$value": "12px"
      },
      "4": {
        "$value": "16px"
      },
      "5": {
        "$value": "20px"
      },
      "6": {
        "$value": "24px"
      },
      "8": {
        "$value": "32px"
      },
      "10": {
        "$value": "40px"
      },
      "12": {
        "$value": "48px"
      },
      "16": {
        "$value": "64px"
      },
      "20": {
        "$value": "80px"
      },
      "$type": "dimension"
    },
    "size": {
      "$type": "dimension",
      "touch-min": {
        "$value": "48px",
        "$description": "Hard floor for any tappable target (Android, WCAG 2.5.8 exceeded)"
      },
      "touch": {
        "$value": "56px",
        "$description": "Default height for buttons, list rows and inputs"
      },
      "icon-sm": {
        "$value": "20px"
      },
      "icon": {
        "$value": "24px"
      },
      "icon-lg": {
        "$value": "32px"
      },
      "rule": {
        "$value": "1px"
      },
      "focus-width-default": {
        "$value": "2px",
        "$description": "Used when the owner declares no focus signature"
      },
      "focus-offset-default": {
        "$value": "2px"
      }
    },
    "font-size": {
      "$type": "dimension",
      "$description": "Major third scale (1.25) anchored on an 18px body. Larger than common defaults on purpose: low vision first.",
      "caption": {
        "$value": "16px",
        "$description": "Smallest allowed text. Nothing below this, ever."
      },
      "label": {
        "$value": "17px"
      },
      "body": {
        "$value": "18px"
      },
      "body-lg": {
        "$value": "20px"
      },
      "title-sm": {
        "$value": "22px"
      },
      "title": {
        "$value": "28px"
      },
      "headline": {
        "$value": "35px"
      },
      "display": {
        "$value": "44px"
      },
      "display-lg": {
        "$value": "55px"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "body": {
        "$value": 1.55
      },
      "reading": {
        "$value": 1.7
      }
    },
    "radius": {
      "$type": "dimension",
      "$description": "Scale is fixed by the root. Families pick which step each component uses.",
      "none": {
        "$value": "0px"
      },
      "xs": {
        "$value": "2px"
      },
      "sm": {
        "$value": "4px"
      },
      "md": {
        "$value": "8px"
      },
      "lg": {
        "$value": "12px"
      },
      "xl": {
        "$value": "20px"
      },
      "full": {
        "$value": "9999px"
      }
    },
    "a11y": {
      "$description": "Rules enforced by scripts/check-contrast.mjs and by component reviews. Not rendered as CSS.",
      "contrast-text-min": {
        "$type": "number",
        "$value": 4.5
      },
      "contrast-body-target": {
        "$type": "number",
        "$value": 7
      },
      "contrast-ui-min": {
        "$type": "number",
        "$value": 3
      },
      "font-scale-max-supported": {
        "$type": "number",
        "$value": 2,
        "$description": "Layouts must survive 200% system font scale without clipping"
      },
      "reduced-motion": {
        "$type": "string",
        "$value": "respect",
        "$description": "When the OS asks for reduced motion, all durations drop to instant and parallax is off"
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "instant": {
          "$value": "80ms"
        },
        "quick": {
          "$value": "160ms"
        },
        "base": {
          "$value": "240ms"
        },
        "slow": {
          "$value": "400ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [
            0.2,
            0,
            0,
            1
          ],
          "$description": "Default enter/move curve when the owner declares none"
        },
        "exit": {
          "$value": [
            0.3,
            0,
            1,
            1
          ]
        },
        "linear": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        }
      }
    }
  }
}