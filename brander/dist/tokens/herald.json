{
  "engine": "1.0.0",
  "owner": "Brander",
  "target": "herald",
  "family": "Scriptorium",
  "settings": {
    "name": "Scriptorium",
    "dynamic-color": "never",
    "dynamic-color-reason": "The palette is the identity. Android wallpaper colors would erase the vellum and tincture system. Dark theme, font scale, contrast level and reduced motion from the OS are still always honored.",
    "radius-component": "xs",
    "radius-container": "sm",
    "fonts": {
      "display": {
        "family": "Grenze Gotisch",
        "fallback": "Georgia, serif",
        "min-size": "title",
        "license": "OFL",
        "note": "Readable blackletter. Display only, never below the title size, never for running text or labels."
      },
      "ui": {
        "family": "Atkinson Hyperlegible Next",
        "fallback": "system-ui, sans-serif",
        "license": "OFL",
        "note": "Root default UI face, designed by the Braille Institute for low vision readers."
      },
      "reading": {
        "family": "Literata",
        "fallback": "Georgia, serif",
        "license": "OFL",
        "note": "Long form reading: notes, articles, Herald transcripts."
      },
      "mono": {
        "family": "Atkinson Hyperlegible Mono",
        "fallback": "ui-monospace, monospace",
        "license": "OFL",
        "note": "Call numbers, identifiers, classification codes."
      }
    }
  },
  "signatures": {
    "focus": {
      "width": "3px",
      "offset": "2px",
      "$description": "Same ring geometry in every Brander family"
    },
    "easing": {
      "name": "settle",
      "value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Every enter and move transition"
    },
    "tick-rule": true,
    "ui-font-default": "Atkinson Hyperlegible Next"
  },
  "color": {
    "light": {
      "background": "#F4EDDF",
      "foreground": "#1C1712",
      "card": "#FBF7EE",
      "card-foreground": "#1C1712",
      "popover": "#FBF7EE",
      "popover-foreground": "#1C1712",
      "primary": "#1E467F",
      "primary-foreground": "#FBF7EE",
      "secondary": "#E9DEC8",
      "secondary-foreground": "#2A231B",
      "muted": "#E9DEC8",
      "muted-foreground": "#574C3F",
      "accent": "#F5E9C4",
      "accent-foreground": "#1C1712",
      "destructive": "#8E2318",
      "destructive-foreground": "#FBF7EE",
      "border": "#D6C7A8",
      "input": "#6E6252",
      "ring": "#1E467F",
      "highlight": "#8F6F1C"
    },
    "dark": {
      "background": "#1A1612",
      "foreground": "#F4EDDF",
      "card": "#241F19",
      "card-foreground": "#F4EDDF",
      "popover": "#322B23",
      "popover-foreground": "#F4EDDF",
      "primary": "#9DBCEA",
      "primary-foreground": "#12100C",
      "secondary": "#322B23",
      "secondary-foreground": "#F4EDDF",
      "muted": "#241F19",
      "muted-foreground": "#B9A784",
      "accent": "#3A3020",
      "accent-foreground": "#E3C46E",
      "destructive": "#EC9A88",
      "destructive-foreground": "#12100C",
      "border": "#4A4035",
      "input": "#B9A784",
      "ring": "#9DBCEA",
      "highlight": "#E3C46E"
    }
  },
  "foundation": {
    "$description": "Armature engine foundation: scales and accessibility rules every owner inherits. An owner may override scale values in owner.json 'foundation'; the a11y block can be made stricter, never looser.",
    "space": {
      "0": {
        "$value": "0px"
      },
      "1": {
        "$value": "4px"
      },
      "2": {
        "$value": "8px"
      },
      "3": {
        "$value": "12px"
      },
      "4": {
        "$value": "16px"
      },
      "5": {
        "$value": "20px"
      },
      "6": {
        "$value": "24px"
      },
      "8": {
        "$value": "32px"
      },
      "10": {
        "$value": "40px"
      },
      "12": {
        "$value": "48px"
      },
      "16": {
        "$value": "64px"
      },
      "20": {
        "$value": "80px"
      },
      "$type": "dimension"
    },
    "size": {
      "$type": "dimension",
      "touch-min": {
        "$value": "48px",
        "$description": "Hard floor for any tappable target (Android, WCAG 2.5.8 exceeded)"
      },
      "touch": {
        "$value": "56px",
        "$description": "Default height for buttons, list rows and inputs"
      },
      "icon-sm": {
        "$value": "20px"
      },
      "icon": {
        "$value": "24px"
      },
      "icon-lg": {
        "$value": "32px"
      },
      "rule": {
        "$value": "1px"
      },
      "focus-width-default": {
        "$value": "2px",
        "$description": "Used when the owner declares no focus signature"
      },
      "focus-offset-default": {
        "$value": "2px"
      }
    },
    "font-size": {
      "$type": "dimension",
      "$description": "Major third scale (1.25) anchored on an 18px body. Larger than common defaults on purpose: low vision first.",
      "caption": {
        "$value": "14px",
        "$description": "Smallest allowed text. Nothing below this, ever."
      },
      "label": {
        "$value": "16px"
      },
      "body": {
        "$value": "18px"
      },
      "body-lg": {
        "$value": "20px"
      },
      "title-sm": {
        "$value": "22px"
      },
      "title": {
        "$value": "28px"
      },
      "headline": {
        "$value": "35px"
      },
      "display": {
        "$value": "44px"
      },
      "display-lg": {
        "$value": "55px"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "body": {
        "$value": 1.55
      },
      "reading": {
        "$value": 1.7
      }
    },
    "radius": {
      "$type": "dimension",
      "$description": "Scale is fixed by the root. Families pick which step each component uses.",
      "none": {
        "$value": "0px"
      },
      "xs": {
        "$value": "2px"
      },
      "sm": {
        "$value": "4px"
      },
      "md": {
        "$value": "8px"
      },
      "lg": {
        "$value": "12px"
      },
      "xl": {
        "$value": "20px"
      },
      "full": {
        "$value": "9999px"
      }
    },
    "a11y": {
      "$description": "Rules enforced by scripts/check-contrast.mjs and by component reviews. Not rendered as CSS.",
      "contrast-text-min": {
        "$type": "number",
        "$value": 4.5
      },
      "contrast-body-target": {
        "$type": "number",
        "$value": 7
      },
      "contrast-ui-min": {
        "$type": "number",
        "$value": 3
      },
      "font-scale-max-supported": {
        "$type": "number",
        "$value": 2,
        "$description": "Layouts must survive 200% system font scale without clipping"
      },
      "reduced-motion": {
        "$type": "string",
        "$value": "respect",
        "$description": "When the OS asks for reduced motion, all durations drop to instant and parallax is off"
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "instant": {
          "$value": "80ms"
        },
        "quick": {
          "$value": "160ms"
        },
        "base": {
          "$value": "240ms"
        },
        "slow": {
          "$value": "400ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [
            0.2,
            0,
            0,
            1
          ],
          "$description": "Default enter/move curve when the owner declares none"
        },
        "exit": {
          "$value": [
            0.3,
            0,
            1,
            1
          ]
        },
        "linear": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        }
      }
    }
  }
}